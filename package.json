{
  "name": "table-to-app-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "点検案件管理のWebアプリ化 - 架空データによる模擬納品事例",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/db/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:watch": "node --watch --test tests/unit/*.test.ts tests/db/*.test.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "supabase:start": "node node_modules/supabase/dist/supabase.js start",
    "supabase:stop": "node node_modules/supabase/dist/supabase.js stop",
    "supabase:reset": "node node_modules/supabase/dist/supabase.js db reset",
    "supabase:types": "node node_modules/supabase/dist/supabase.js gen types typescript --local > lib/database.types.ts",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "26.1.0",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
