# Supabase
# Production prefers publishable / secret keys. Local Supabase can use anon / service_role as fallbacks.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=replace-only-on-server-or-local-seed

# Demo accounts
DEMO_ADMIN_EMAIL=admin@table-to-app.example
DEMO_STAFF_EMAIL=staff@table-to-app.example
DEMO_VIEWER_EMAIL=viewer@table-to-app.example
DEMO_PASSWORD=
NEXT_PUBLIC_DEMO_PASSWORD=
NEXT_PUBLIC_DEMO_NOTE=

# Remote integration-test guard. Leave empty for local Supabase tests.
ALLOW_REMOTE_TESTS=
REMOTE_TEST_PROJECT_REF=

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY are server-only and bypass RLS.
# Never expose server-only keys to Client Components or browser bundles.
# NEXT_PUBLIC_DEMO_PASSWORD is intentionally visible in the browser for the public demo and is not a secret.
